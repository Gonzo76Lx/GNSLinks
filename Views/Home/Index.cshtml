@{
    ViewData["Title"] = "Portal de Recursos & Links";
    var isAuth = User?.Identity?.IsAuthenticated == true;
    var isAdmin = isAuth && !string.IsNullOrEmpty(User?.Identity?.Name) && User.Identity.Name.EndsWith("Administrator", StringComparison.InvariantCultureIgnoreCase);
}

<div class="dashboard-container">
    <!-- Controls Header: Search & Category Filter Pills -->
    <div class="search-filter-wrapper">
        <div class="search-box-container">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="linkSearchInput" class="search-input" placeholder="Pesquisar por nome, URL, servidor ou comando (Pressione '/' para focar)..." autocomplete="off" />
            <span class="search-shortcut">/</span>
        </div>

        <div class="filter-pills" id="filterPills">
            <button type="button" class="filter-pill active" data-filter="all">
                Todos os Links <span class="count" id="totalCount">(0)</span>
            </button>
            <button type="button" class="filter-pill" data-filter="varios">
                Vários
            </button>
            <button type="button" class="filter-pill" data-filter="pca">
                PCA / Unit4
            </button>
            <button type="button" class="filter-pill" data-filter="canais">
                Canais
            </button>
            <button type="button" class="filter-pill" data-filter="servidores">
                Servidores Úteis
            </button>
            <button type="button" class="filter-pill" data-filter="documentacao">
                Documentação
            </button>
            <button type="button" class="filter-pill" data-filter="departamentais">
                Departamentais
            </button>
            @if (isAdmin)
            {
                <button type="button" class="filter-pill" data-filter="admin">
                    Administração
                </button>
                <button type="button" class="filter-pill" data-filter="docker">
                    Docker
                </button>
            }
        </div>
    </div>

    <!-- Cards Grid -->
    
